{
  "name": "hackers-lair",
  "productName": "Hacker's Lair",
  "version": "2.1.0-beta.13",
  "description": "Local-first desktop console for coding projects, processes, ports, and logs.",
  "author": "Hacker's Lair contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackerslairhq/desktop.git"
  },
  "homepage": "https://hackerslairhq.github.io/desktop/",
  "main": "desktop.js",
  "bin": {
    "lair": "bin/lair.js"
  },
  "scripts": {
    "start": "electron-forge start",
    "server": "node server.js",
    "desktop": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "notices": "node scripts/generate-third-party-notices.js",
    "release:notes": "node scripts/extract-release-notes.js",
    "prepackage": "npm run notices",
    "premake": "npm run notices",
    "smoke:package": "node scripts/smoke-packaged-lifecycle.js",
    "smoke:install": "node scripts/smoke-windows-installer.js",
    "docs:screenshots": "node scripts/capture-readme-screenshots.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:ui": "python tests/ui_playwright.py",
    "test:site-ui": "python tests/site_playwright.py"
  },
  "files": [
    "app-config.js",
    "bin/",
    "CHANGELOG.md",
    "desktop.js",
    "forge.config.js",
    "icon.ico",
    "icon.png",
    "lib/",
    "LICENSE",
    "preload.js",
    "projects.example.json",
    "public/",
    "README.md",
    "scripts.example.json",
    "schemas/",
    "server.js",
    "settings.example.json",
    "THIRD_PARTY_NOTICES.txt",
    "uninstall.ps1"
  ],
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "43.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "update-electron-app": "^3.3.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.4",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
